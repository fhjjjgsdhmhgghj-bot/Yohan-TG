<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Yohan TG"
            android:textColor="@color/accent"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="أدخل API ID"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <!-- Step 1: API ID -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilApiId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/api_id_hint"
            app:boxBackgroundMode="outline"
            android:layout_marginBottom="12dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etApiId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:textColor="@color/text" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Step 2: API Hash -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilApiHash"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/api_hash_hint"
            app:boxBackgroundMode="outline"
            android:visibility="gone"
            android:layout_marginBottom="12dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etApiHash"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:textColor="@color/text" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Step 3: Phone -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/phone_hint"
            app:boxBackgroundMode="outline"
            android:visibility="gone"
            android:layout_marginBottom="12dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="phone"
                android:textColor="@color/text" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Step 4: Code -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/code_hint"
            app:boxBackgroundMode="outline"
            android:visibility="gone"
            android:layout_marginBottom="12dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:textColor="@color/text" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Step 5: 2FA Password -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/password_hint"
            app:boxBackgroundMode="outline"
            android:visibility="gone"
            android:layout_marginBottom="12dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:textColor="@color/text" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Groups -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilSource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/source_link_hint"
            app:boxBackgroundMode="outline"
            android:visibility="gone"
            android:layout_marginBottom="12dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:textColor="@color/text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilTarget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/target_link_hint"
            app:boxBackgroundMode="outline"
            android:visibility="gone"
            android:layout_marginBottom="12dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTarget"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:textColor="@color/text" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Speed -->
        <TextView
            android:id="@+id/tvSpeedLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="سرعة الإضافة"
            android:textColor="@color/text_secondary"
            android:visibility="gone"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spinnerSpeed"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:visibility="gone"
            android:layout_marginBottom="16dp" />

        <!-- Accounts list -->
        <TextView
            android:id="@+id/tvAccounts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text"
            android:textSize="13sp"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAction"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/btn_next"
            app:backgroundTint="@color/accent"
            android:textColor="@color/text" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddAccount"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/btn_add_account"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:visibility="gone"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginTop="16dp"
            android:lineSpacingExtra="2dp" />

    </LinearLayout>
</ScrollView>